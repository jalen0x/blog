# Only RAILS_MASTER_KEY lives in 1Password — it's what unlocks everything else.
# Do NOT quote ${SECRETS} — kamal's dotenv parser relies on shellescape/shellsplit
# round-tripping the fetched value, and outer quotes break that.
SECRETS=$(kamal secrets fetch --adapter 1password --account my --from Private/aam5y4onzoq65dtuoxnk2jdb6y RAILS_MASTER_KEY)
RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY ${SECRETS})

# Everything else is decrypted locally at deploy time from Rails production credentials.
# These commands do not start with `kamal secrets`, so kamal routes them through
# plain backtick sh — pipes and quoting behave normally.
KAMAL_REGISTRY_PASSWORD=$(bin/rails credentials:show -e production | ruby -ryaml -e 'puts YAML.safe_load(STDIN.read).dig("kamal", "registry_password")')
POSTGRES_PASSWORD=$(bin/rails credentials:show -e production | ruby -ryaml -e 'puts YAML.safe_load(STDIN.read).dig("database", "password")')
MADMIN_USER=$(bin/rails credentials:show -e production | ruby -ryaml -e 'puts YAML.safe_load(STDIN.read).dig("madmin", "user")')
MADMIN_PASSWORD=$(bin/rails credentials:show -e production | ruby -ryaml -e 'puts YAML.safe_load(STDIN.read).dig("madmin", "password")')
